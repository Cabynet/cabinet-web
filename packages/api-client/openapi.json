  "components": {
    "schemas": {
      "AuthUser": {
        "type": "object",
        "required": [
          "id",
          "email",
          "name"
        ],
        "properties": {
          "avatar_url": {
            "type": "string",
            "nullable": true
          },
          "email": {
            "type": "string"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "BookmarkListItem": {
        "type": "object",
        "required": [
          "id",
          "item_type",
          "title",
          "is_pinned",
          "is_favorite",
          "is_archived",
          "metadata_status",
          "tags",
          "created_at",
          "updated_at"
        ],
        "properties": {
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "favicon_url": {
            "type": "string",
            "nullable": true
          },
